{
    "name": "ade-ridwan/pay-relay-php",
    "description": "Relay QRIS Statis menjadi Dinamis dengan kode unik dan webhook custom Android notification listener",
    "type": "library",
    "license": "MIT",
    "keywords": ["qris", "qris-dinamis", "payment", "laravel", "webhook"],
    "authors": [
        {
            "name": "Ade Ridwan",
            "email": "sukun024@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/database": "^10.0|^11.0",
        "illuminate/events": "^10.0|^11.0",
        "illuminate/http": "^10.0|^11.0",
        "illuminate/routing": "^10.0|^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "orchestra/testbench": "^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "AdeRidwan\\PayRelayPhp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AdeRidwan\\PayRelayPhp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AdeRidwan\\PayRelayPhp\\Laravel\\PayRelayServiceProvider"
            ],
            "aliases": {
                "PayRelay": "AdeRidwan\\PayRelayPhp\\Laravel\\Facades\\PayRelay"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "audit": {
            "block-insecure": false
        }
    }
}
